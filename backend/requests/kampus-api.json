          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"6 etkinlik\", function () { pm.expect(pm.response.json()).to.be.an(\"array\").with.lengthOf(6); });",
              "const events = pm.response.json();",
              "pm.test(\"MongoDB alanları\", function () { events.forEach(event => { pm.expect(event._id).to.match(/^[a-f0-9]{24}$/); pm.expect(event).to.have.property(\"createdAt\"); pm.expect(event).to.have.property(\"updatedAt\"); }); });",
              "if (Array.isArray(events) && events[0]?._id) pm.collectionVariables.set(\"eventId\", events[0]._id);"
            ]
          }
        }
      ]
